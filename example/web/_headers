# Global security headers for the main site (Flutter app cross-origin isolation)
/*
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: frame-ancestors *
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# Fallback headers for CDN widget and assets
/cdn/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

# Cache-Control: CDN HTML entrypoint must revalidate so updates are immediate
/cdn/
  Cache-Control: public, max-age=0, must-revalidate

# Cache-Control: Immutable static Next.js assets (chunks, styles, wasm) cached for 1 year
/cdn/_next/*
  Cache-Control: public, max-age=31536000, immutable